# Copy to backend/.env and fill in real values. Never commit secrets.
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL="mysql://root:password@localhost:3306/maher_ayan_birthday"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-first-run

# Optional S3-compatible media storage. If omitted, local development storage is used.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Upload limits
MAX_IMAGE_MB=15
MAX_VIDEO_MB=250
